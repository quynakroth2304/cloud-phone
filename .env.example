# Cấu hình G8X Cloud Phone (Chạy trong Termux trên LG G8X ThinQ)
# Chỉ lắng nghe tại 127.0.0.1 để bảo mật tuyệt đối, truy cập ngoài qua Cloudflare Tunnel
HOST=127.0.0.1
PORT=3000

# Mật khẩu Admin đã băm bằng bcrypt (Mặc định bên dưới tương ứng với mật khẩu: g8x-admin-2026)
# Để tạo hash mới trong Termux: node -e "console.log(require('bcryptjs').hashSync('MAT_KHAU_MOI', 10))"
ADMIN_PASSWORD_HASH="$2b$10$m8G6fH8X7kL9pQ2vR5wT1uY4zA6bC8dE0fG2hI4jK6lM8nO0pQ2rS"

# Khóa bí mật ký Session Cookie (httpOnly)
SESSION_SECRET="g8x-thinq-cloudphone-secret-key-change-me-in-production"

# Địa chỉ ADB nội bộ trên chính chiếc LG G8X (Wireless Debugging hoặc TCP/IP 5555)
ADB_HOST=127.0.0.1
ADB_PORT=5555

# Ngưỡng nhiệt độ bảo vệ pin khi cắm sạc 24/7 (°C)
THERMAL_THROTTLE_C=42
THERMAL_CRITICAL_C=45

# Cho phép chạy lệnh ADB Shell tùy ý trên giao diện (mặc định tắt để bảo mật)
ALLOW_ARBITRARY_SHELL=false

# Giới hạn dung lượng upload APK/File tối đa (MB)
MAX_UPLOAD_MB=150
